# ==============================================================================
# Transactional Email Service Configuration (Resend)
# ==============================================================================
# 1. Sign up for a free Resend account at https://resend.com
# 2. Generate an API Key under API Keys (https://resend.com/api-keys)
# 3. Paste your real API key below in .env.local (do NOT commit .env.local)
RESEND_API_KEY=re_your_resend_api_key_here

# The recipient email where you want to receive inquiries
CONTACT_RECEIVER_EMAIL=laibamehreenk@gmail.com

# Verified sender email in Resend
# For testing without a custom domain, you can use: Portfolio Contact <onboarding@resend.dev>
# For production with your own verified domain: Contact <hello@yourdomain.com>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Client-side contact email display
NEXT_PUBLIC_CONTACT_EMAIL=laibamehreenk@gmail.com
