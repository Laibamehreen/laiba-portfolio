# ==============================================================================
# SMTP Email Delivery Configuration (Recommended)
# ==============================================================================
# Configure standard SMTP to receive contact form submissions directly to your email.
#
# FOR GMAIL:
# 1. Enable 2-Step Verification on your Google Account (Security settings).
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password (name it "Portfolio" or "Website").
# 4. Copy the generated 16-character password into SMTP_PASS below.
#
# FOR OUTLOOK / OFFICE 365:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=laibamehreenk@gmail.com
SMTP_PASS=your_16_character_app_password_here
SMTP_FROM="Laiba Mehreen Portfolio" <laibamehreenk@gmail.com>

# The recipient email where you want to receive inquiries
CONTACT_RECEIVER_EMAIL=laibamehreenk@gmail.com

# ==============================================================================
# Transactional Email Service Alternative (Resend)
# ==============================================================================
# If you prefer using Resend instead of SMTP, configure this:
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ==============================================================================
# Client-Side Settings
# ==============================================================================
NEXT_PUBLIC_CONTACT_EMAIL=laibamehreenk@gmail.com
