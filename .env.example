# ==============================================================================
# Gmail SMTP Email Delivery Configuration (Nodemailer)
# ==============================================================================
# To set up Gmail SMTP:
# 1. Turn on 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password (Select App: Mail, Device: Portfolio):
#    https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-character App Password below.

GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
CONTACT_EMAIL=yourgmail@gmail.com

# Optional SMTP fallback aliases:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password
CONTACT_RECEIVER_EMAIL=yourgmail@gmail.com

# Client-Side Settings (Public info only, never credentials)
NEXT_PUBLIC_CONTACT_EMAIL=yourgmail@gmail.com
